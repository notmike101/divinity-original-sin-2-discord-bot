{"parse":{"title":"Elemental Totem","pageid":11554,"text":{"*":"<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><p class=\"mw-empty-elt\">\n</p><aside role=\"region\" class=\"portable-infobox pi-background pi-border-color pi-theme-wikia pi-layout-default\"><section class=\"pi-item pi-group pi-border-color\" data-item-name=\"header\">\n\t\n<h2 class=\"pi-item pi-item-spacing pi-title pi-secondary-background\" data-source=\"name\">Elemental Totem</h2>\n\n</section>\n\n\t<section class=\"pi-item pi-panel pi-border-color wds-tabber\">\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tabs__wrapper\">\n\t\t\t\t<ul class=\"wds-tabs\">\n\t\t\t\t\t\n\t\t\t\t\t\t<li class=\"wds-tabs__tab wds-is-current\">\n\t\t\t\t\t\t\t<div class=\"wds-tabs__tab-label\">\n\t\t\t\t\t\t\t\tDefinitive Edition\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tab__content wds-is-current\">\n\t\t\t\t\n<figure class=\"pi-item pi-image\" data-source=\"dos2de image\">\n\t<a href=\"https://static.wikia.nocookie.net/divinity2/images/4/4c/Elemental_Totem.png/revision/latest?cb=20200901100754\" class=\"image image-thumbnail\" title=\"Elemental Totem\">\n\t\t<img src=\"https://static.wikia.nocookie.net/divinity2/images/4/4c/Elemental_Totem.png/revision/latest?cb=20200901100754\" srcset=\"https://static.wikia.nocookie.net/divinity2/images/4/4c/Elemental_Totem.png/revision/latest?cb=20200901100754 1x, https://static.wikia.nocookie.net/divinity2/images/4/4c/Elemental_Totem.png/revision/latest?cb=20200901100754 2x\" class=\"pi-image-thumbnail\" data-relevant=\"1\" alt=\"Elemental Totem\" width=\"64\" height=\"64\" data-image-key=\"Elemental_Totem.png\" data-image-name=\"Elemental Totem.png\" />\n\t\t\n\t</a>\n\t<figcaption class=\"pi-item-spacing pi-caption\">Skill icon</figcaption>\n</figure>\n<section class=\"pi-item pi-group pi-border-color\">\n\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"dos2de class\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Skill class</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Summoning_(Original_Sin_2)\" class=\"mw-redirect\" title=\"Summoning (Original Sin 2)\">Summoning</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"dos2de ability\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Ability Lvl</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">1</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"dos2de tier\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Skill Tier</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Starter</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"dos2de level\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Rq. Level</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">1</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"dos2de environment\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Environmental effects</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Totem type depends on surface it is summoned on</div>\n</div>\n\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<section class=\"pi-item pi-smart-group pi-border-color\">\n    \n        <section class=\"pi-smart-group-head pi-border-color\">\n            \n                <h3 class=\"pi-smart-data-label pi-data-label pi-secondary-font pi-item-spacing pi-border-color\" style=\"width: calc(1 / 3 * 100%);\" data-source=\"dos2de ap\">Action Points</h3>\n            \n                <h3 class=\"pi-smart-data-label pi-data-label pi-secondary-font pi-item-spacing pi-border-color\" style=\"width: calc(1 / 3 * 100%);\" data-source=\"dos2de base cooldown\">Base Cooldown</h3>\n            \n                <h3 class=\"pi-smart-data-label pi-data-label pi-secondary-font pi-item-spacing pi-border-color\" style=\"width: calc(1 / 3 * 100%);\" data-source=\"dos2de range\">Range</h3>\n            \n        </section>\n    \n    <section class=\"pi-smart-group-body pi-border-color\">\n        \n            <div class=\"pi-smart-data-value pi-data-value pi-font pi-item-spacing pi-border-color\" style=\"width: calc(1 / 3 * 100%);\" data-source=\"dos2de ap\">2</div>\n        \n            <div class=\"pi-smart-data-value pi-data-value pi-font pi-item-spacing pi-border-color\" style=\"width: calc(1 / 3 * 100%);\" data-source=\"dos2de base cooldown\">1 turn</div>\n        \n            <div class=\"pi-smart-data-value pi-data-value pi-font pi-item-spacing pi-border-color\" style=\"width: calc(1 / 3 * 100%);\" data-source=\"dos2de range\">13m</div>\n        \n    </section>\n</section>\n<section class=\"pi-item pi-smart-group pi-border-color\">\n    \n        <section class=\"pi-smart-group-head pi-border-color\">\n            \n                <h3 class=\"pi-smart-data-label pi-data-label pi-secondary-font pi-item-spacing pi-border-color\" style=\"width: calc(1 / 3 * 100%);\" data-source=\"dos2de damage\">Damage Type</h3>\n            \n                <h3 class=\"pi-smart-data-label pi-data-label pi-secondary-font pi-item-spacing pi-border-color\" style=\"width: calc(1 / 3 * 100%);\" data-source=\"dos2de duration\">Duration</h3>\n            \n                <h3 class=\"pi-smart-data-label pi-data-label pi-secondary-font pi-item-spacing pi-border-color\" style=\"width: calc(1 / 3 * 100%);\" data-source=\"dos2de memory\">Memory Slots</h3>\n            \n        </section>\n    \n    <section class=\"pi-smart-group-body pi-border-color\">\n        \n            <div class=\"pi-smart-data-value pi-data-value pi-font pi-item-spacing pi-border-color\" style=\"width: calc(1 / 3 * 100%);\" data-source=\"dos2de damage\">Depends on surface</div>\n        \n            <div class=\"pi-smart-data-value pi-data-value pi-font pi-item-spacing pi-border-color\" style=\"width: calc(1 / 3 * 100%);\" data-source=\"dos2de duration\">3 turns</div>\n        \n            <div class=\"pi-smart-data-value pi-data-value pi-font pi-item-spacing pi-border-color\" style=\"width: calc(1 / 3 * 100%);\" data-source=\"dos2de memory\">1</div>\n        \n    </section>\n</section>\n\n</section>\n\n\t\t\t</div>\n\t\t\n\t</section>\n\n\n\n</aside>\n\n<p class=\"mw-empty-elt\"></p><p><b>Elemental totem</b> is a <a href=\"/wiki/Summoning\" title=\"Summoning\">starter Summoning</a> <a href=\"/wiki/Original_Sin_2_Skills\" title=\"Original Sin 2 Skills\">skill</a> in <i><a href=\"/wiki/Divinity:_Original_Sin_II\" title=\"Divinity: Original Sin II\">Divinity: Original Sin II</a></i>.\n</p>\n<div id=\"toc\" class=\"toc\" role=\"navigation\" aria-labelledby=\"mw-toc-heading\"><input type=\"checkbox\" role=\"button\" id=\"toctogglecheckbox\" class=\"toctogglecheckbox\" style=\"display:none\" /><div class=\"toctitle\" lang=\"en\" dir=\"ltr\"><h2 id=\"mw-toc-heading\">Contents</h2><span class=\"toctogglespan\"><label class=\"toctogglelabel\" for=\"toctogglecheckbox\"></label></span></div>\n<ul>\n<li class=\"toclevel-1 tocsection-1\"><a href=\"#Description\"><span class=\"tocnumber\">1</span> <span class=\"toctext\">Description</span></a>\n<ul>\n<li class=\"toclevel-2 tocsection-2\"><a href=\"#Skill\"><span class=\"tocnumber\">1.1</span> <span class=\"toctext\">Skill</span></a></li>\n<li class=\"toclevel-2 tocsection-3\"><a href=\"#Scroll_and_Skillbook\"><span class=\"tocnumber\">1.2</span> <span class=\"toctext\">Scroll and Skillbook</span></a></li>\n<li class=\"toclevel-2 tocsection-4\"><a href=\"#Skill_Modifiers\"><span class=\"tocnumber\">1.3</span> <span class=\"toctext\">Skill Modifiers</span></a></li>\n</ul>\n</li>\n<li class=\"toclevel-1 tocsection-5\"><a href=\"#Locations\"><span class=\"tocnumber\">2</span> <span class=\"toctext\">Locations</span></a>\n<ul>\n<li class=\"toclevel-2 tocsection-6\"><a href=\"#Traders\"><span class=\"tocnumber\">2.1</span> <span class=\"toctext\">Traders</span></a></li>\n</ul>\n</li>\n<li class=\"toclevel-1 tocsection-7\"><a href=\"#Crafting\"><span class=\"tocnumber\">3</span> <span class=\"toctext\">Crafting</span></a></li>\n<li class=\"toclevel-1 tocsection-8\"><a href=\"#Gallery\"><span class=\"tocnumber\">4</span> <span class=\"toctext\">Gallery</span></a></li>\n</ul>\n</div>\n\n<h2><span class=\"mw-headline\" id=\"Description\">Description</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Sign in to edit\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"log-in-edit-section\" data-action=\"edit-section\" href=\"https://auth.fandom.com/signin?redirect=https%3A%2F%2Fdivinity.fandom.com%2Fwiki%2FElemental_Totem%3Fveaction%3Dedit%26section%3D1&amp;uselang=en&amp;metadata=article-registration-edit-article-section\" data-auth-modal=\"signin\" data-testid=\"log-in-edit-section\" aria-label=\"Sign in to edit\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<h3><span class=\"mw-headline\" id=\"Skill\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/divinity2/images/4/4c/Elemental_Totem.png/revision/latest?cb=20200901100754\" class=\"mw-file-description image\"><img alt=\"Elemental Totem\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"50\" class=\"mw-file-element lazyload\" data-image-name=\"Elemental Totem.png\" data-image-key=\"Elemental_Totem.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/divinity2/images/4/4c/Elemental_Totem.png/revision/latest/scale-to-width-down/50?cb=20200901100754\" /></a></span> Skill</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Sign in to edit\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"log-in-edit-section\" data-action=\"edit-section\" href=\"https://auth.fandom.com/signin?redirect=https%3A%2F%2Fdivinity.fandom.com%2Fwiki%2FElemental_Totem%3Fveaction%3Dedit%26section%3D2&amp;uselang=en&amp;metadata=article-registration-edit-article-section\" data-auth-modal=\"signin\" data-testid=\"log-in-edit-section\" aria-label=\"Sign in to edit\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h3>\n<p><b>Elemental Totem</b> will summon an uncontrollable totem minion onto the battlefield for the player and depending on the field they summon it on it will change accordingly, if not summoned onto any specific field it will be a generic Wood Totem that does physical damage.\n</p>\n<dl><dt>Variants</dt></dl>\n<ul><li>Fire Totem - Fires small fireballs, causes burning and can ignite oil and poison fields.</li>\n<li>Water Totem - Fires bolts of water, causes wet.</li>\n<li>Oil Totem - Fires oil, causes slowed.</li>\n<li>Electric Totem - Fires lightning, can cause puddles to become stun fields.</li>\n<li>Poison Totem - Fires poison bolts.</li>\n<li>Blood Totem - Fires blood balls.</li></ul>\n<p>Since Elemental Totem relies on <a href=\"/wiki/Summoning\" title=\"Summoning\">Summoning</a> magic it cannot be cast if caster is affected by <span typeof=\"mw:File\"><a href=\"/wiki/Silenced_(Status)\" title=\"Silenced (Status)\"><img alt=\"Silenced (Original Sin 2)\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" class=\"mw-file-element lazyload\" data-image-name=\"Silenced (Original Sin 2).png\" data-image-key=\"Silenced_%28Original_Sin_2%29.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/divinity2/images/f/fd/Silenced_%28Original_Sin_2%29.png/revision/latest/scale-to-width-down/30?cb=20230822150818\" /></a></span> <span class=\"new\" title=\"Silenced (Status) (page does not exist)\" data-uncrawlable-url=\"L3dpa2kvU2lsZW5jZWRfKFN0YXR1cyk/YWN0aW9uPWVkaXQmcmVkbGluaz0x\">Silenced</span> and <span typeof=\"mw:File\"><a href=\"/wiki/Enraged_(Status)\" title=\"Enraged (Status)\"><img alt=\"Enraged (Original Sin 2)\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"25\" height=\"25\" class=\"mw-file-element lazyload\" data-image-name=\"Enraged (Original Sin 2).png\" data-image-key=\"Enraged_%28Original_Sin_2%29.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/divinity2/images/9/9a/Enraged_%28Original_Sin_2%29.png/revision/latest/scale-to-width-down/25?cb=20230803150004\" /></a></span> <a href=\"/wiki/Enraged_(Status)\" title=\"Enraged (Status)\">Enraged</a> status effects.\n</p>\n<h3><span class=\"mw-headline\" id=\"Scroll_and_Skillbook\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/divinity2/images/d/da/Elemental_Totem_Scroll_%28Original_Sin_2%29.png/revision/latest?cb=20230923125938\" class=\"mw-file-description image\"><img alt=\"Elemental Totem Scroll (Original Sin 2)\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"50\" class=\"mw-file-element lazyload\" data-image-name=\"Elemental Totem Scroll (Original Sin 2).png\" data-image-key=\"Elemental_Totem_Scroll_%28Original_Sin_2%29.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/divinity2/images/d/da/Elemental_Totem_Scroll_%28Original_Sin_2%29.png/revision/latest/scale-to-width-down/50?cb=20230923125938\" /></a></span> Scroll and Skillbook</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Sign in to edit\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"log-in-edit-section\" data-action=\"edit-section\" href=\"https://auth.fandom.com/signin?redirect=https%3A%2F%2Fdivinity.fandom.com%2Fwiki%2FElemental_Totem%3Fveaction%3Dedit%26section%3D3&amp;uselang=en&amp;metadata=article-registration-edit-article-section\" data-auth-modal=\"signin\" data-testid=\"log-in-edit-section\" aria-label=\"Sign in to edit\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h3>\n<p><b>Elemental Totem skillbook</b> is a magical item that allows its reader to learn Elemental Totem skill, if they have at least 1 point into <a href=\"/wiki/Original_Sin_2_Summoning\" title=\"Original Sin 2 Summoning\">Summoning</a> <a href=\"/wiki/Attributes_and_Abilities_(Original_Sin_2)\" title=\"Attributes and Abilities (Original Sin 2)\">ability</a>, and use it indefinitely. In order to be able to cast the skill, character needs 1 free memory slot. Note that the book will disappear once read. The book weights 0.5 and its base value is 120 gold. A skillbook can be crafted if a Elemental Totem scroll is combined with a <a href=\"/wiki/Blank_Summoning_Skillbook\" title=\"Blank Summoning Skillbook\">Blank Summoning Skillbook</a>. Since Elemental Totem is a starter Summoning skill, it is available right from the start of the game. Traders selling Summoning skillbooks will have this book for sale since the start of the game as well. \n</p><p><b>Elemental Totem scroll</b> is a magical item that allows any character to cast Elemental Totem skill, regardless of skill prerequisites, but only once. The only limiting element in casting Elemental Totem this way is the amount of <span typeof=\"mw:File\"><a href=\"/wiki/Action_Points_(Original_Sin_2)\" title=\"Action Points (Original Sin 2)\"><img alt=\"Action Point Icon (Original Sin 2)\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"30\" class=\"mw-file-element lazyload\" data-image-name=\"Action Point Icon (Original Sin 2).png\" data-image-key=\"Action_Point_Icon_%28Original_Sin_2%29.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/divinity2/images/5/53/Action_Point_Icon_%28Original_Sin_2%29.png/revision/latest/scale-to-width-down/30?cb=20240109115929\" /></a></span> <a href=\"/wiki/Original_Sin_2_Action_Points\" title=\"Original Sin 2 Action Points\">Action Points (AP)</a> character has at their disposal in current turn. The scroll is craftable, weights 0.02 and has base value of 60 gold.\n</p><p>The cost of Action Points between Elemental Totem scroll and Elemental Totem skill themselves remains the same. Both the scroll and the skill itself are affected by other skills, attributes and talents that may provide additional bonuses.\n</p>\n<h3><span class=\"mw-headline\" id=\"Skill_Modifiers\"><span typeof=\"mw:File\"><a href=\"https://static.wikia.nocookie.net/divinity2/images/3/30/Summoning_Icon_%28Original_Sin_2%29.png/revision/latest?cb=20230726182251\" class=\"mw-file-description image\"><img alt=\"Summoning Icon (Original Sin 2)\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"50\" class=\"mw-file-element lazyload\" data-image-name=\"Summoning Icon (Original Sin 2).png\" data-image-key=\"Summoning_Icon_%28Original_Sin_2%29.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/divinity2/images/3/30/Summoning_Icon_%28Original_Sin_2%29.png/revision/latest/scale-to-width-down/50?cb=20230726182251\" /></a></span> Skill Modifiers</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Sign in to edit\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"log-in-edit-section\" data-action=\"edit-section\" href=\"https://auth.fandom.com/signin?redirect=https%3A%2F%2Fdivinity.fandom.com%2Fwiki%2FElemental_Totem%3Fveaction%3Dedit%26section%3D4&amp;uselang=en&amp;metadata=article-registration-edit-article-section\" data-auth-modal=\"signin\" data-testid=\"log-in-edit-section\" aria-label=\"Sign in to edit\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h3>\n<table class=\"di-notice\" style=\"max-width:100%\">\n<tbody><tr>\n<th style=\"background-color:Blue\">&#160;\n</th>\n<td>\n</td>\n<td>This section is missing, please fill it in.\n</td></tr></tbody></table>\n<p><br />\n</p>\n<h2><span class=\"mw-headline\" id=\"Locations\">Locations</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Sign in to edit\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"log-in-edit-section\" data-action=\"edit-section\" href=\"https://auth.fandom.com/signin?redirect=https%3A%2F%2Fdivinity.fandom.com%2Fwiki%2FElemental_Totem%3Fveaction%3Dedit%26section%3D5&amp;uselang=en&amp;metadata=article-registration-edit-article-section\" data-auth-modal=\"signin\" data-testid=\"log-in-edit-section\" aria-label=\"Sign in to edit\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<h3><span class=\"mw-headline\" id=\"Traders\">Traders</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Sign in to edit\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"log-in-edit-section\" data-action=\"edit-section\" href=\"https://auth.fandom.com/signin?redirect=https%3A%2F%2Fdivinity.fandom.com%2Fwiki%2FElemental_Totem%3Fveaction%3Dedit%26section%3D6&amp;uselang=en&amp;metadata=article-registration-edit-article-section\" data-auth-modal=\"signin\" data-testid=\"log-in-edit-secti